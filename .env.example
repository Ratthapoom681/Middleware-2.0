# Keep the Docker Compose project/volume identity stable if this folder is renamed.
COMPOSE_PROJECT_NAME=internal-security-middleware

# Image and persistent-volume identity. Existing deployments that do not set
# VOLUME_NAMESPACE keep using the legacy defectdojo-viewer_* volume names.
IMAGE_NAMESPACE=internal-security-middleware
IMAGE_TAG=local
VOLUME_NAMESPACE=internal-security-middleware

# Gateway port exposure
GATEWAY_PORT=80

# Optional override for the gateway URL placed in authenticator-enrollment
# emails. By default Auth uses the browser-facing host/IP from the admin request.
APP_PUBLIC_URL=

# Container timezone
TZ=Asia/Bangkok

# Local-only monitoring dashboard port. Use an SSH tunnel to access it remotely.
MONITOR_PORT=61208

# DefectDojo Viewer app database
PG_DB=defectdojo_viewer
PG_USER=defectdojo
PG_PASSWORD=

# Middleware Hub auth database
AUTH_PG_DB=middleware_auth
AUTH_PG_USER=middleware_auth
AUTH_PG_PASSWORD=

# Shared JWT signing key and internal auth-service introspection token
JWT_SECRET=
AUTH_SERVICE_TOKEN=
# Base64-encoded 32-byte key used only to encrypt authenticator secrets.
# Generate once for production and keep it stable across restarts.
MFA_ENCRYPTION_KEY=

# Used only when auth storage contains no users. Remove it after the initial
# administrator has been created if desired.
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Optional SMTP delivery for authenticator-enrollment notifications. Leave the
# host blank to keep email delivery unavailable. SMTP_USER and SMTP_PASSWORD
# may both remain blank when the relay does not require authentication. Use
# SMTP_SECURE=true for implicit TLS, commonly on port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
