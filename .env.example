# Keep the Docker Compose project/volume identity stable if this folder is renamed.
COMPOSE_PROJECT_NAME=internal-security-middleware

# Gateway port exposure
GATEWAY_PORT=80

# DefectDojo Viewer app database
PG_DB=defectdojo_viewer
PG_USER=defectdojo
PG_PASSWORD=change-me

# Middleware Hub auth database
AUTH_PG_DB=middleware_auth
AUTH_PG_USER=middleware_auth
AUTH_PG_PASSWORD=change-me

# Shared JWT signing key and internal Hub introspection token
JWT_SECRET=change-this-jwt-secret
AUTH_SERVICE_TOKEN=change-this-internal-service-token
